# ============================================================
# Pharma DNA Saga 2025 — Environment Variables Reference
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgres://pharma_dna_user:changeme@localhost:5432/pharma_dna
PGHOST=localhost
PGPORT=5432
PGUSER=pharma_dna_user
PGPASSWORD=changeme
PGDATABASE=pharma_dna

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Sui Blockchain ─────────────────────────────────────────
SUI_NETWORK=testnet
SUI_ADMIN_PRIVATE_KEY= # Base64-encoded Sui admin private key
SUI_PACKAGE_ID=        # Deployed contract package ID

# ── AI Agent (OpenAI) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_AGENT_AUTO_EXECUTE_ONCHAIN=false   # true = agent can auto-execute on-chain txs

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=             # min 32-char random string
ADMIN_JWT_SECRET=       # min 32-char random string (admin-only routes)

# ── Pinata (IPFS metadata storage) ──────────────────────────
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ── Sentry (error tracking) ────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=pharma-dna
SENTRY_PROJECT=pharma-dna-saga

# ── Docker Production ─────────────────────────────────────
# POSTGRES_PASSWORD=      # Used by docker-compose.yml
# SUI_NETWORK=            # testnet | devnet | mainnet
# SUI_ADMIN_PRIVATE_KEY=   # Admin key for on-chain operations
# OPENAI_API_KEY=         # Your OpenAI API key
# AI_AGENT_AUTO_EXECUTE_ONCHAIN=false
# JWT_SECRET=             # Generate: openssl rand -base64 32
# ADMIN_JWT_SECRET=       # Generate: openssl rand -base64 32
