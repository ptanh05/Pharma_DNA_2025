# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=your_gateway_url

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# Speech & Image Recognition
SPEECH_TO_TEXT_PROVIDER=openai
IMAGE_RECOGNITION_PROVIDER=google
GOOGLE_VISION_API_KEY=your_google_vision_api_key
GOOGLE_PROJECT_ID=your_google_project_id

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# SUI Blockchain
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=your_package_id
SUI_ADMIN_CAP_OBJECT_ID=your_admin_cap_object_id
SUI_CONTRACT_OBJECT_ID=your_contract_object_id
OWNER_PRIVATE_KEY=your_owner_private_key

# Public (client-side)
NEXT_PUBLIC_SUI_PACKAGE_ID=your_package_id
NEXT_PUBLIC_SUI_CONTRACT_OBJECT_ID=your_contract_object_id
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_OWNER_ADDRESS=your_owner_address

# Security
JWT_SECRET=your_jwt_secret
ADMIN_PASSWORD=your_admin_password
NEXT_PUBLIC_ADMIN_USERNAME=your_admin_username

# Feature flags
FORCE_DB_ONLY=false
